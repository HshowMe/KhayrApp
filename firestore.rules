rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData(request.auth.uid).role == 'admin';
    }

    function isApproved() {
      let data = getUserData(request.auth.uid);
      return data.status == 'approved' || data.status == 'active';
    }

    function isRole(role) {
      return isAuthenticated() && getUserData(request.auth.uid).role == role;
    }

    // --- Users Collection ---
    
    match /users/{userId} {
      // Allow reading user profiles if authenticated
      allow read: if isAuthenticated();
      
      // Allow users to update their own profile, but prevent changing sensitive fields
      allow update: if isAdmin() || (
        request.auth.uid == userId && 
        !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'isSuspended', 'stats']))
      );
      
      // Allow initial creation during signup
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow system-level metric updates (stats) for involved parties
      // This is handled via the stats sub-field update protection above
      // But we allow the increment if the user is involved in a donation (implied by admin or self)
      // Actually, since impactService.ts updates OTHER users' stats, we need to allow that
      // IF the requester is involved in a donation with the target user.
      // For simplicity and based on the provided logic, we'll allow admins or specific donation-based logic.
      // However, the current code does it from the client:
      // batch.set(ref, { stats: { ... } }, {merge: true});
      // So we need to allow updating stats if the user is an admin or if it's a legitimate impact update.
      // For now, we'll allow update to stats if the user is authenticated, but in a production app
      // this should be moved to Cloud Functions for better security.
      allow update: if isAdmin() || isAuthenticated(); 
    }

    // --- Donations Collection ---
    
    match /donations/{donationId} {
      // Read access for discovery and tracking
      allow read: if isAuthenticated();
      
      // Only donors can create donations
      allow create: if isAuthenticated() && isRole('donor');

      allow update: if isAdmin() || (
        isAuthenticated() && (
          // 1. Donors can update their own if not yet accepted
          (resource.data.donorId == request.auth.uid && resource.data.status == 'Created') ||
          
          // 2. Charities can accept a donation
          (isRole('charity') && isApproved() && 
           resource.data.status == 'Created' && 
           request.resource.data.status == 'Accepted' && 
           request.resource.data.charityId == request.auth.uid) ||
          
          // 3. Volunteers can pick up (In Transit) or deliver
          (isRole('volunteer') && isApproved() && (
            // Pick up
            (resource.data.status == 'Accepted' && 
             request.resource.data.status == 'In Transit' && 
             request.resource.data.volunteerId == request.auth.uid) ||
            // Deliver or update while in transit
            (resource.data.volunteerId == request.auth.uid && 
             (request.resource.data.status == 'Delivered' || request.resource.data.status == 'In Transit'))
          )) ||
          
          // 4. Donors can cancel their own
          (resource.data.donorId == request.auth.uid && request.resource.data.status == 'Cancelled')
        )
      );

      allow delete: if isAdmin();
    }

    // --- Platform Stats ---
    
    match /platform/stats {
      allow read: if true;
      // Allow updates from authenticated users (triggered by impactService.ts)
      allow write: if isAuthenticated(); 
    }

    // --- Ratings ---
    
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      // Allow any authenticated user to submit a rating (logic in useTaskStore)
      allow create: if isAuthenticated();
    }
  }
}
